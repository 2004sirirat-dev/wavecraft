:root{
  --ink:#14141c;
  --ink-2:#1c1c26;
  --ink-3:#26262f;
  --bone:#efebe3;
  --bone-dim:#a8a49c;
  --lime:#d4ff3f;
  --violet:#8b7fd9;
  --line: rgba(239,235,227,0.1);
}
*{box-sizing:border-box;}
html,body{
  margin:0;
  background:var(--ink);
  color:var(--bone);
  font-family:'Inter',sans-serif;
  line-height:1.5;
}
h1,h2,h3,.display{
  font-family:'Space Grotesk',sans-serif;
  font-weight:500;
  margin:0;
}
nav{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:24px 48px;
  border-bottom:1px solid var(--line);
}
.logo{
  font-family:'Space Grotesk',sans-serif;
  font-weight:700;
  font-size:20px;
  letter-spacing:-0.02em;
  display:flex;
  align-items:center;
  gap:10px;
}
.logo-mark{
  width:14px;height:14px;
  background:var(--lime);
  border-radius:3px;
  transform:rotate(45deg);
}
.nav-links{display:flex;gap:32px;align-items:center;}
.nav-links a{color:var(--bone-dim);text-decoration:none;font-size:14px;}
.nav-cta{
  background:var(--bone);
  color:var(--ink);
  border:none;
  padding:10px 18px;
  border-radius:100px;
  font-size:14px;
  font-weight:600;
  cursor:pointer;
}
.create-section{
  max-width:760px;
  margin:0 auto;
  padding:72px 24px 56px;
  text-align:center;
}
.create-section h1{
  font-size:44px;
  letter-spacing:-0.02em;
  margin-bottom:14px;
}
.create-section p.sub{
  color:var(--bone-dim);
  font-size:16px;
  margin-bottom:40px;
  max-width:480px;
  margin-left:auto;
  margin-right:auto;
}
.create-panel{
  background:var(--ink-2);
  border:1px solid var(--line);
  border-radius:20px;
  padding:22px;
  text-align:left;
}
#prompt{
  width:100%;
  background:transparent;
  border:none;
  color:var(--bone);
  font-family:'Inter',sans-serif;
  font-size:16px;
  resize:none;
  outline:none;
  min-height:56px;
}
#prompt::placeholder{color:var(--bone-dim);}
.chip-row{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  margin:16px 0 20px;
  padding-top:16px;
  border-top:1px solid var(--line);
}
.chip{
  border:1px solid var(--line);
  background:transparent;
  color:var(--bone-dim);
  padding:7px 14px;
  border-radius:100px;
  font-size:13px;
  cursor:pointer;
  transition:border-color .15s, color .15s;
}
.chip.active{
  border-color:var(--lime);
  color:var(--lime);
}
.panel-footer{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:12px;
}
.duration-label{font-size:13px;color:var(--bone-dim);}
.error-label{font-size:13px;color:#ff8080;}
.generate-btn{
  background:var(--lime);
  color:var(--ink);
  border:none;
  padding:12px 22px;
  border-radius:100px;
  font-family:'Space Grotesk',sans-serif;
  font-weight:700;
  font-size:14px;
  cursor:pointer;
  display:flex;
  align-items:center;
  gap:8px;
  white-space:nowrap;
}
.generate-btn:disabled{opacity:0.6;cursor:default;}
.feed-section{
  max-width:1120px;
  margin:0 auto;
  padding:24px 24px 100px;
}
.feed-header{
  display:flex;
  justify-content:space-between;
  align-items:baseline;
  margin-bottom:20px;
}
.feed-header h2{font-size:20px;}
.feed-header span{font-size:13px;color:var(--bone-dim);}
.feed-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(240px, 1fr));
  gap:16px;
}
.card{
  background:var(--ink-2);
  border:1px solid var(--line);
  border-radius:16px;
  padding:16px;
  cursor:pointer;
  transition:border-color .15s, background .15s;
}
.card:hover{background:var(--ink-3);}
.wave{
  height:64px;
  display:flex;
  align-items:flex-end;
  gap:3px;
  margin-bottom:14px;
  overflow:hidden;
}
.wave span{
  flex:1;
  background:var(--violet);
  border-radius:2px;
  opacity:0.5;
  transition:opacity .2s;
}
.card.playing .wave span{
  opacity:1;
  animation:bounce 0.9s ease-in-out infinite;
}
@keyframes bounce{
  0%,100%{transform:scaleY(0.4);}
  50%{transform:scaleY(1);}
}
.card-title{font-size:15px;font-weight:600;margin-bottom:4px;}
.card-meta{font-size:13px;color:var(--bone-dim);margin-bottom:12px;}
.card-foot{
  display:flex;
  justify-content:space-between;
  align-items:center;
}
.tag{
  font-size:11px;
  color:var(--bone-dim);
  border:1px solid var(--line);
  padding:3px 9px;
  border-radius:100px;
}
.play-btn{
  width:32px;height:32px;
  border-radius:50%;
  background:var(--ink-3);
  border:1px solid var(--line);
  display:flex;align-items:center;justify-content:center;
  color:var(--bone);
  flex-shrink:0;
}
.card.playing .play-btn{background:var(--lime);color:var(--ink);border-color:var(--lime);}
@media (max-width:640px){
  nav{padding:18px 20px;}
  .nav-links{display:none;}
  .create-section{padding:48px 16px 40px;}
  .create-section h1{font-size:32px;}
}
.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);}
